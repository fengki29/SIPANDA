# Salin menjadi .env.docker lalu isi APP_KEY:
#   cp .env.docker.example .env.docker
#   php artisan key:generate --show
APP_NAME=Sipanda
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_OUTPUT_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sipanda
DB_USERNAME=sipanda
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
